#!/bin/bash
set -euo pipefail

# OmaSecBoot: sbctl signing, Limine enrollment, pacman hook, and Windows BootNext handoff.
# Ongoing maintenance handled by zz-omasecboot-cleanup.hook, zz-sbctl.hook,
# zzz-omasecboot.hook, and the Limine post-hook zzz-omasecboot-sign.

# Resolve lib directory (handles symlinks from /usr/local/bin -> /usr/local/lib)
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/../lib/omasecboot"
# Fallback for development (running from repo checkout)
[[ -d "$LIB_DIR" ]] || LIB_DIR="${SCRIPT_DIR}/../lib"

for lib in common checks discover sign enroll windows status; do
  # shellcheck source=/dev/null
  source "${LIB_DIR}/${lib}.sh"
done

# --- Commands ----------------------------------------------------------------

cmd_setup() {
  header "Secure Boot Setup"
  check_deps
  check_efi_mode
  check_root "setup"
  require_gum

  create_keys
  ensure_limine_secure_boot_settings || die "Could not update Limine Secure Boot settings"
  refresh_limine_config || die "Could not regenerate Limine config"

  with_boot_repair_lock
  snapshot_limine_conf_hash
  ensure_windows_boot_entry || true
  reenroll_limine_config_if_changed || die "Could not enroll Limine config checksum"

  clean_stale_entries

  echo
  echo -e "  ${BOLD}Signing EFI files${NC}"
  local sign_rc=0
  sign_all_efi || sign_rc=$?

  echo
  echo -e "  ${BOLD}Next steps${NC}"
  echo "    1. Reboot into BIOS/UEFI firmware settings"
  echo "    2. Enable Setup Mode (clear/reset Secure Boot keys)"
  echo "    3. Save and exit BIOS"
  echo -e "    4. Run ${BOLD}sudo omasecboot enroll${NC}"
  echo

  return $sign_rc
}

cmd_enroll() {
  header "Key Enrollment"
  check_deps
  check_efi_mode
  check_root "enroll"
  require_gum
  enroll_keys
}

cmd_windows_help() {
  header "Windows Dual-Boot"
  echo -e "  ${BOLD}Usage${NC}   sudo omasecboot windows <command>"
  echo
  echo -e "  ${BOLD}Commands${NC}"
  echo "    available   Check for Windows Boot Manager without root or output"
  echo "    setup       Add the firmware BootNext entry to the Limine menu"
  echo "    bootnext    Set firmware BootNext without rebooting"
  echo "    reboot      Set firmware BootNext and reboot immediately"
  echo
}

cmd_windows() {
  if (( $# > 1 )); then
    cmd_windows_help
    fail "Expected one Windows command"
    return 1
  fi

  case "${1:-}" in
    available)
      find_windows_boot_entry >/dev/null
      ;;
    setup)
      check_root "windows setup"
      if windows_entry_is_configured; then
        header "Windows Dual-Boot"
        pass "Windows boot entry already in limine.conf"
        return 0
      fi
      check_deps
      require_gum
      add_windows_boot_entry
      ;;
    bootnext)
      check_root "windows bootnext"
      header "Boot to Windows"
      set_windows_bootnext
      ;;
    reboot)
      check_root "windows reboot"
      header "Boot to Windows"
      reboot_to_windows
      ;;
    help|--help|-h)
      cmd_windows_help
      ;;
    "")
      cmd_windows_help
      return 1
      ;;
    *)
      cmd_windows_help
      fail "Unknown Windows command: $1"
      return 1
      ;;
  esac
}

cmd_cleanup() {
  check_core_deps
  check_root "cleanup"
  check_esp_mount
  with_repair_lock
  clean_stale_entries
}

cmd_sign() {
  check_deps
  check_root "sign"
  with_boot_repair_lock
  qheader "Signing EFI Files"
  ensure_limine_secure_boot_settings || die "Could not update Limine Secure Boot settings"
  snapshot_limine_conf_hash
  ensure_windows_boot_entry || true
  reenroll_limine_config_if_changed || die "Could not enroll Limine config checksum"
  clean_stale_entries
  local sign_rc=0
  sign_all_efi || sign_rc=$?
  return $sign_rc
}

cmd_status() {
  check_core_deps
  show_status
}

cmd_help() {
  header "Command Help"
  echo "  Secure Boot signing, Limine enrollment, pacman hooks, and Windows BootNext handoff for Omarchy."
  echo -e "  After setup, ${DIM}zz-omasecboot-cleanup.hook${NC}, ${DIM}zz-sbctl.hook${NC}, ${DIM}zzz-omasecboot.hook${NC},"
  echo -e "  and Limine post-hook ${DIM}zzz-omasecboot-sign${NC} keep Secure Boot state repaired."
  echo
  echo -e "  ${BOLD}Usage${NC}   sudo omasecboot <command>"
  echo
  echo -e "  ${BOLD}Commands${NC}"
  echo "    setup       Set Limine verification/enrollment state and sign EFI files"
  echo "    enroll      Enroll keys into firmware (requires Setup Mode)"
  echo "    windows     Set up or hand off to Windows through firmware BootNext"
  echo "    status      Show Secure Boot status and file verification"
  echo "    sign        Reassert Limine settings, repair config drift, and sign EFI files"
  echo "    cleanup     Remove stale sbctl tracked-file entries"
  echo "    help        Show this help"
  echo
  echo -e "  ${DIM}Note:${NC} This tool keeps ${BOLD}ENABLE_VERIFICATION=no${NC} for Omarchy's EFI UKI flow while using Limine config enrollment."
  echo -e "        ${BOLD}status${NC} warns if Limine 12 Secure Boot path-hash enforcement would affect non-EFI paths."
  echo -e "        Limine-originated boot drift is repaired by the Limine post-hook after upstream writes finish."
  echo
  echo -e "  ${BOLD}Workflow${NC}"
  echo "    1. sudo omasecboot setup"
  echo "    2. Reboot -> BIOS -> enable Setup Mode (clear keys)"
  echo "    3. sudo omasecboot enroll"
  echo "    4. Reboot -> BIOS -> enable Secure Boot"
  echo "    5. sudo omasecboot windows setup"
  echo
}

# --- Dispatch ----------------------------------------------------------------

main() {
  # Parse global flags
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --quiet) QUIET=true; export QUIET; shift ;;
      *)       break ;;
    esac
  done

  case "${1:-}" in
    setup)    cmd_setup ;;
    enroll)   cmd_enroll ;;
    windows)  shift; cmd_windows "$@" ;;
    cleanup)  cmd_cleanup ;;
    sign)     cmd_sign ;;
    status)   cmd_status ;;
    help|--help|-h)  cmd_help ;;
    *)
      cmd_help
      if [[ -n "${1:-}" ]]; then
        fail "Unknown command: $1"
        echo
      fi
      return 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
